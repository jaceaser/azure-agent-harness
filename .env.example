# Local / shared
APP_ENV=development
AGENT_VERSION=0.1.0
PROMPT_VERSION=example-v1
POLICY_VERSION=example-v1

# Microsoft Foundry
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=<model-deployment-name>

# Azure identity
# In local development the starter uses AzureCliCredential by default.
# In production set USE_MANAGED_IDENTITY=true.
USE_MANAGED_IDENTITY=false
AZURE_CLIENT_ID=

# Inbound auth (Entra ID)
# Local development defaults to disabled; production must use entra.
AUTH_MODE=disabled
# Primary Entra tenant ID for token validation.
ENTRA_TENANT_ID=
# Comma-separated accepted audiences, e.g. api://azure-agent-harness or the API app client ID.
ENTRA_API_AUDIENCE=
# Optional comma-separated tenant allowlist; defaults to ENTRA_TENANT_ID when empty.
ENTRA_ALLOWED_TENANT_IDS=

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=azure-agent-harness

# Optional production features
ENABLE_EPISODIC_MEMORY=false
ENABLE_SEMANTIC_MEMORY=false
ENABLE_SERVICE_BUS=false
ENABLE_DURABLE_WORKFLOWS=false
